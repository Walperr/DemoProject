<Window x:Class="RegistrationDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Форма регистрации" Height="380" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Регистрация участника" FontSize="18" FontWeight="Bold"
                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16"/>

        <TextBlock Text="Имя:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="4"/>

        <TextBlock Text="Email:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="EmailTextBox" Grid.Row="2" Grid.Column="1" Margin="0,6" Padding="4"/>

        <TextBlock Text="Дата рождения:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <DatePicker x:Name="BirthDatePicker" Grid.Row="3" Grid.Column="1" Margin="0,6"/>

        <Button x:Name="SubmitButton" Content="Зарегистрироваться"
                Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                Margin="0,18,0,0" Padding="14,6"
                Click="SubmitButton_Click"/>

        <TextBlock x:Name="ResultTextBlock" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0,18,0,0" TextWrapping="Wrap" Foreground="DarkGreen" FontSize="13"/>
    </Grid>
</Window>
